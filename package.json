{
  "name": "mobileplayers",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "tsx --test tests/*.test.ts",
    "conferir": "tsx scripts/conferir.ts",
    "pc": "tsx servidor/pc.ts",
    "pc:abrir": "powershell -NoProfile -ExecutionPolicy Bypass -File servidor/abrir.ps1",
    "pc:instalar": "powershell -NoProfile -ExecutionPolicy Bypass -File servidor/instalar.ps1",
    "pc:desinstalar": "powershell -NoProfile -ExecutionPolicy Bypass -File servidor/desinstalar.ps1"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}
